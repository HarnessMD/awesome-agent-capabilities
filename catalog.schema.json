{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HarnessMD/awesome-agent-capabilities/main/catalog.schema.json",
  "title": "Awesome agent capabilities: one data file",
  "description": "A file in data/. Each entry is one item of the list. The Munder Difflin app runs the same rules and a few more (the exact form of an install step) before the list is signed.",
  "$ref": "#/$defs/dataFile",
  "$defs": {
    "dataFile": {
      "type": "object",
      "required": [
        "entries"
      ],
      "additionalProperties": false,
      "properties": {
        "wave": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "note": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
      "description": "Lower case letters, digits and dashes, unique in the list."
    },
    "featured": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "step": {
      "type": "object",
      "required": [
        "argv"
      ],
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "description": "One program and its arguments, never a shell line.",
          "prefixItems": [
            {
              "enum": [
                "claude",
                "codex",
                "npx",
                "npm",
                "pnpm",
                "bun",
                "uv",
                "uvx",
                "pipx",
                "pip",
                "brew",
                "gh",
                "cargo",
                "go"
              ]
            }
          ],
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9@+=:,./_-]{1,300}$"
          }
        },
        "label": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "install": {
      "type": "object",
      "required": [
        "door",
        "manual"
      ],
      "additionalProperties": false,
      "properties": {
        "door": {
          "enum": [
            "mcp-local",
            "skill-folder",
            "command",
            "none"
          ]
        },
        "ref": {
          "$ref": "#/$defs/id"
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/tree/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)+/?$"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "manual": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "door": {
                "const": "mcp-local"
              }
            }
          },
          "then": {
            "required": [
              "ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "door": {
                "const": "skill-folder"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "door": {
                "const": "command"
              }
            }
          },
          "then": {
            "required": [
              "steps"
            ]
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "purposes",
        "maker",
        "tier",
        "source",
        "what",
        "wave",
        "worksWith",
        "install"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "mcp-server",
            "skill",
            "skill-pack",
            "plugin",
            "subagent-set",
            "hook-pack",
            "status-line",
            "tool",
            "agent",
            "app"
          ]
        },
        "purposes": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "enum": [
              "source-control",
              "code-review",
              "testing",
              "devtools",
              "frontend",
              "backend",
              "mobile",
              "databases",
              "data",
              "cloud",
              "observability",
              "security",
              "sandboxes",
              "browsers",
              "search",
              "research",
              "documents",
              "docs",
              "design",
              "media",
              "memory",
              "reasoning",
              "planning",
              "specs",
              "communication",
              "calendar",
              "files",
              "automation",
              "marketing",
              "sales",
              "support",
              "payments",
              "finance",
              "hr",
              "legal",
              "ai",
              "agents",
              "orchestration",
              "usage",
              "utilities"
            ]
          }
        },
        "maker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "tier": {
          "enum": [
            "first-party",
            "vendor",
            "community"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^https://[^\\s]{4,400}$"
        },
        "what": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "\\S"
        },
        "wave": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "worksWith": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "claude",
              "codex",
              "antigravity",
              "cursor",
              "copilot",
              "opencode",
              "gemini",
              "grok",
              "any"
            ]
          }
        },
        "licence": {
          "type": [
            "string",
            "null"
          ]
        },
        "signIn": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "none",
                "key",
                "oauth"
              ]
            },
            "secretNames": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
              }
            }
          }
        },
        "can": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reads",
            "writes",
            "sends",
            "spends",
            "deletes"
          ],
          "properties": {
            "reads": {
              "type": "boolean"
            },
            "writes": {
              "type": "boolean"
            },
            "sends": {
              "type": "boolean"
            },
            "spends": {
              "type": "boolean"
            },
            "deletes": {
              "type": "boolean"
            }
          }
        },
        "canChecked": {
          "type": "boolean"
        },
        "ships": {
          "enum": [
            "instructions",
            "scripts",
            "hooks",
            "bundled-server",
            "hosted-server",
            "binary",
            "unknown"
          ]
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "archived": {
              "type": "boolean"
            },
            "lastRelease": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastReleaseAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastPushAt": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "pinned": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "riskFloor": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "riskNote": {
          "type": "string",
          "maxLength": 240
        },
        "install": {
          "$ref": "#/$defs/install"
        },
        "also": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s]{4,400}$"
          },
          "description": "Other addresses of the same thing, used to find twins."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "wave": {
                "enum": [
                  1,
                  2
                ]
              }
            }
          },
          "then": {
            "required": [
              "can"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "wave": {
                "const": 3
              }
            }
          },
          "then": {
            "properties": {
              "install": {
                "properties": {
                  "door": {
                    "const": "none"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
